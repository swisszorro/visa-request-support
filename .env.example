# ---------------------------------------------------------------------------
# Berne World Cup – Visa Request Service configuration
# Copy this file to ".env" and fill in the values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Passport reading engine -----------------------------------------------
# gemini = Google Gemini Flash vision (needs GEMINI_API_KEY) [default]
# vision = Claude vision (alias: claude; needs ANTHROPIC_API_KEY) - no Google involved
# ocr    = local Tesseract + MRZ parser (NO API key, needs tesseract binary)
# Chain with commas: the first engine reads everything, the next ones only the files
# the previous one could not read SAFELY (error / no passport / check digits failed).
# Recommended without Google:  PASSPORT_ENGINE=vision,ocr
PASSPORT_ENGINE=gemini

# --- Google Gemini (PASSPORT_ENGINE=gemini) --------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta
# Parallel Gemini requests. 4 balances speed vs. memory on shared hosting;
# raise (6-8) on a real server, lower (2-3) if you hit memory/rate limits.
GEMINI_CONCURRENCY=4

# --- OCR engine (PASSPORT_ENGINE=ocr) --------------------------------------
TESSERACT_BIN=tesseract
# Visual-zone language (place of birth). Plain "eng" is fine here.
TESSERACT_LANG=eng
# MRZ language: the MRZ uses the OCR-B font → use the OCR-B trained model
# ("mrz" or "ocrb", installed by the Dockerfile). Falls back to eng if missing.
TESSERACT_MRZ_LANG=mrz
# Width (px) the MRZ band is upscaled to before background removal + OCR.
MRZ_PREP_WIDTH=1600
# Two-digit year pivot for date-of-birth century (<=pivot => 20xx, else 19xx).
# Leave empty to use the current year automatically.
MRZ_DOB_PIVOT_YEAR=

# --- Claude Vision (only used when PASSPORT_ENGINE=vision) ------------------
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 = good balance; claude-opus-5-5 = most accurate, slower and dearer
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=4000
# Parallel Claude requests per upload
ANTHROPIC_CONCURRENCY=4

# --- Service authentication (see README "Authentisierung") -----------------
# Comma-separated list of accepted API keys. The caller must send one of them
# in the "Authorization: Bearer <key>" or "X-API-Key: <key>" header.
SERVICE_API_KEYS=changeme-generate-a-long-random-key

# Optional: require an additional HMAC signature for fully automated callers.
# When set, the caller must send X-Signature: hex(hmac_sha256(rawBody, secret)).
SERVICE_HMAC_SECRET=

# --- Output & conversion ---------------------------------------------------
# Returned document format: 'pdf' (needs a converter, see PDF_CONVERTER) or
# 'docx' (no system binaries → works on classic shared hosting).
OUTPUT_FORMAT=pdf
# PDF converter when OUTPUT_FORMAT=pdf:
#   soffice   = local LibreOffice headless (own server / Docker)
#   gotenberg = HTTP call to a Gotenberg service (set GOTENBERG_URL) — no local binary
PDF_CONVERTER=soffice
GOTENBERG_URL=
# Optional HTTP basic auth if Gotenberg sits behind an auth proxy.
GOTENBERG_USER=
GOTENBERG_PASS=

# PDF input handling:
#   auto    = poppler when pdftoppm is installed, else native [default, recommended]
#   poppler = rasterise every page via pdftoppm: many passports per PDF, page cap, rotation-safe
#   native  = send the PDF straight to Gemini/Claude (no binary needed, shared hosting)
PDF_MODE=auto

# --- External binaries (own server / Docker only) --------------------------
# Path to LibreOffice headless binary (DOCX -> PDF; PDF_CONVERTER=soffice).
SOFFICE_BIN=soffice
# Path to poppler's pdftoppm (PDF page -> PNG; PDF_MODE=poppler / ocr engine).
PDFTOPPM_BIN=pdftoppm

# --- Input by URL (e.g. Gravity Flow webhook sends file URLs) --------------
# Optional allow-list of hosts the service may download excel_url/images_urls
# from (comma-separated). Empty = allow any http(s) host. Set to your WP host
# to prevent SSRF, e.g. ALLOWED_FETCH_HOSTS=alpha-impact.swiss,www.alpha-impact.swiss
ALLOWED_FETCH_HOSTS=

# --- Limits ----------------------------------------------------------------
MAX_IMAGES=24
# Max PDF pages analysed per uploaded PDF (more pages are reported in file_diagnostics).
MAX_PDF_PAGES=30
# Image long-edge (px) sent to the vision API. 1600 keeps MRZ legible & cheap.
VISION_IMAGE_MAXEDGE=1600

# --- Email delivery (send the letter as attachment) ------------------------
# Enable globally, or per request via form field send_email=1.
MAIL_ENABLED=false
# Recipients: request "mail_to" wins; else the applicant/federation "email"
# field; else this default (comma-separated allowed).
MAIL_DEFAULT_TO=
# Values with spaces MUST be quoted (phpdotenv fails otherwise → app 500).
MAIL_SUBJECT="Berne World Cup – Visa Invitation Letter"
MAIL_FROM=berneworldcup@alpha-impact.swiss
MAIL_FROM_NAME="Berne World Cup OC"

# Mail body. Send as HTML? then use <br>, <p>, <a> … in MAIL_BODY.
MAIL_HTML=false
# Body template. MUST be quoted. Multi-line: use "\n" escapes (double quotes)
# or real line breaks inside the quotes. Placeholders:
#   {federation} {name} {firstname} {filename}
#   {applicants_total} {passports_detected} {successful} {failed} {failed_list}
# Leave empty for the built-in default body.
# Plain-text example:
MAIL_BODY="Dear {federation}\n\nAttached is the official invitation letter ({filename}).\n\nVerified: {successful} of {applicants_total}. Failed: {failed}.\n{failed_list}\n\nBest regards\nBerne World Cup Organizing Committee"
# HTML example (set MAIL_HTML=true):
# MAIL_BODY="<p>Dear {federation},</p><p>Attached is the official invitation letter (<b>{filename}</b>).</p><p>Verified: {successful} of {applicants_total}. Failed: {failed}.</p><p>Best regards<br>Berne World Cup Organizing Committee</p>"
# SMTP (Hostpoint: asmtp.mail.hostpoint.ch, Port 587 TLS, user = full mailbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=

# --- PDF watermark ---------------------------------------------------------
# Diagonal text watermark on every page (empty = none). Per request override
# via form field "watermark". Rendered by LibreOffice/Gotenberg + Word.
WATERMARK_TEXT=
# Hex color without '#'. C0C0C0 = light grey.
WATERMARK_COLOR=C0C0C0

# --- Plausibility rules -----------------------------------------------------
# Passport must be valid this many months beyond the departure date (fail-closed).
PASSPORT_MIN_VALIDITY_MONTHS=6
# Optional event window (ISO dates). Travel dates outside it only produce a warning.
EVENT_START=2026-11-12
EVENT_END=2026-11-14

# --- Misc ------------------------------------------------------------------
# Loosen place-of-birth check to a warning (does not fail the match) when true.
PLACE_OF_BIRTH_WARN_ONLY=true
APP_DEBUG=false
# Logging on/off. false = no files written (incl. passport-reads.log with
# cleartext passport data). Set true to re-enable for debugging.
LOGGING_ENABLED=false
